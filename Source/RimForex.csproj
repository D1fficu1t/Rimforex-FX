<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimForex</AssemblyName>
    <RootNamespace>RimForex</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>

    <!-- ── 可重现构建 ──
         不设这个的话，PE 头里的 TimeDateStamp 会是"编译时刻"，
         于是**一个字都没改、重新编译一次，DLL 的字节也会不同**（实测差 645 字节 / 0.63%）。
         后果：DLL 被纳入版本控制（见 .gitignore 的说明）后，
         每次构建都会显示成一个"已修改"的二进制提交，无法分辨是真的改了代码还是只是重新编译。

         开启后同一份源码产出逐字节相同的 DLL，于是：
           · DLL 变了 ⇔ 代码真的变了
           · 可以用哈希核对"游戏里装的是不是这一版" -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <!-- ── 版本号 ──
         这里必须与 About/About.xml 的 <modVersion> 保持一致，改一处就要改两处。

         为什么要在这里重复一遍：GenerateAssemblyInfo 默认产出的是 1.0.0，
         而加载时那条日志（RimForexBootstrap）是从程序集元数据读版本的 ——
         不设这里的话，日志会打印 1.0.0，与 mod 列表里显示的 0.3.0-preview2 对不上。

         ContinuousIntegrationBuild 会在 InformationalVersion 后面追加
         `+<40 位提交哈希>`，所以日志实际形如 0.3.0-preview2+1483697... ——
         既能看出是哪一版，也能看出由哪份源码编出来。 -->
    <Version>0.3.0-preview2</Version>
  </PropertyGroup>

  <!-- ══════════════════════════════════════════════════════════════════════
       把源码提交哈希嵌进程序集（可选，失败不影响编译）

       `ContinuousIntegrationBuild` 正常情况下会让 MSBuild 自己从 `.git`
       里读出提交哈希、写进 AssemblyInformationalVersion。但它只会**从项目
       目录向上**找 `.git`。

       ── 为什么要额外处理 ──
       本项目的 git 仓库不在 mod 文件夹里，而在同级目录：

           test\RimForex\        mod 文件夹（干净的，没有 .git）
           test\RimForex.git\    仓库本体

       原因是游戏上传创意工坊时把 mod 根目录整个交给 Steam、不排除任何文件，
       若 .git 留在里面，完整版本历史会被分发给每个订阅者。
       副作用：MSBuild 向上找不到仓库，于是不再嵌入哈希，日志退回只有 "0.3.0-preview2"。

       这里补一个 target 直接问 git 要哈希。

       ── 三种情况都不会让编译失败 ──
         · 仓库在 mod 文件夹里（普通 clone / CI）：MSBuild 自己就能拿到，
           本 target 因为 `$(SourceRevisionId)` 已有值而跳过
         · 仓库在外面的 RimForex.git：本 target 生效，显式传入
         · 完全没有仓库（解压的源码包）：git 命令失败，IgnoreExitCode 兜住，
           日志就只显示版本号
       ══════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <ExternalGitDir>$(MSBuildProjectDirectory)\..\..\RimForex.git</ExternalGitDir>
  </PropertyGroup>

  <Target Name="InjectGitRevision"
          BeforeTargets="GetAssemblyVersion"
          Condition="'$(SourceRevisionId)' == '' AND Exists('$(ExternalGitDir)')">
    <Exec Command="git --git-dir=&quot;$(ExternalGitDir)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FxGitSha" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(_FxGitSha)' != ''">$(_FxGitSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- ══════════════════════════════════════════════════════════════════════
       游戏安装路径：不进版本控制，按机器自己配

       `RimWorldDir` 是**每台机器都不同**的绝对路径，所以不能写死在这里 ——
       写死了别人 clone 下来就编不过（他那条路径不存在）。

       改从 Local.props 读。该文件已被 .gitignore 排除，每人一份：
         · 本机：把 Local.props.example 复制成 Local.props，填上自己的游戏路径
         · CI ：没有这个文件，于是走下面的 NuGet 引用程序集那条路
       ══════════════════════════════════════════════════════════════════════ -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>
    <ModAssemblies>$(ModRoot)\Assemblies</ModAssemblies>
  </PropertyGroup>

  <!-- ══════════════════════════════════════════════════════════════════════
       引用来源：二选一，按本机是否装了游戏自动切换

       为什么需要两条路：
         · 本机开发   —— 直接引用游戏目录里的真程序集，最准确
         · CI / 他人  —— 那里没有游戏，改用 Krafs.Rimworld.Ref 这个 NuGet 包

       Krafs.Rimworld.Ref 是**经过 Ludeon 许可发布**的引用程序集
       （把方法体剥掉只留签名），所以它不违反版权、也不能用来运行游戏，
       但编译器需要的信息一样不少。选它的版本号与游戏版本对齐。

       两条路产出的 DLL 必须一致 —— 否则"本地测试通过、CI 构建的却不一样"，
       那是比不能 CI 更糟的情况。所以下面的引用列表**逐条对应**，不多不少。
       ══════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <GameManagedDir>$(RimWorldDir)\RimWorldWin64_Data\Managed</GameManagedDir>
    <!-- 只要这一个文件在，就认为本机装了游戏 -->
    <UseGameAssemblies Condition="Exists('$(GameManagedDir)\Assembly-CSharp.dll')">true</UseGameAssemblies>
    <UseGameAssemblies Condition="'$(UseGameAssemblies)' == ''">false</UseGameAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseGameAssemblies)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameAssemblies)' != 'true'">
    <!-- 版本号请与 About/About.xml 里 supportedVersions 的目标游戏版本保持一致 -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 构建后把 DLL 直接放到 Mod 的 Assemblies 目录，拷贝到游戏即可用。
       注意：CI 上不需要这一步（release 工作流自己打包），但留着无害。 -->
  <Target Name="CopyToModFolder" AfterTargets="Build">
    <MakeDir Directories="$(ModAssemblies)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModAssemblies)" />
    <Message Importance="high" Text="RimForex.dll -> $(ModAssemblies)" />
    <Message Importance="high" Text="引用来源: $(UseGameAssemblies) (true=本机游戏, false=NuGet 引用程序集)" />
  </Target>

</Project>
