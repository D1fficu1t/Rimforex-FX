<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RimForex_TradingTerminal</defName>
    <label>FX trading terminal</label>
    <description>A console hardwired into the interstellar FX exchange. Deposit silver as margin and trade faction currencies with leverage.</description>
    <thingClass>RimForex.Building_FXTradingTerminal</thingClass>
    <category>Building</category>
    <designationCategory>Production</designationCategory>
    <drawerType>MapMeshAndRealTime</drawerType>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>30</pathCost>

    <!-- 不要写 thingCategories：本建筑不可搬运(minifiable=false)，
         挂存储分类会触发 "is not minifiable yet has thing categories" 配置错误。 -->

    <!-- 建筑必须自带 graphicData，否则 ThingDefGenerator_Buildings 生成蓝图/框架时
         GraphicData.CopyFrom 会拿到 null 直接崩溃整个 Def 加载阶段。 -->
    <graphicData>
      <texPath>Things/Building/RimForex/FXTradingTerminal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.2)</drawSize>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <statBases>
      <WorkToBuild>1500</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Silver>150</Silver>
    </costList>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>3.5</glowRadius>
        <glowColor>(120,190,255,0)</glowColor>
      </li>
    </comps>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isEdifice>false</isEdifice>
    </building>
  </ThingDef>

</Defs>
