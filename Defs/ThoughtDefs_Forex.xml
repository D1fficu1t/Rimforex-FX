<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ══════════════════════════════════════════════════════════════════════
       平仓心情：每平一笔仓就按该笔盈亏挂心情，最多同时挂 3 档，同档最多叠 3 层。

       ── 结构 ──
       每一档是一个独立的 ThoughtDef（所以不同档能同时显示）。
       每档 3 个 stage，依次对应叠了 1 / 2 / 3 层；
       ThoughtWorker_FxCloseMood 用 ActiveAtStage(层数-1) 选档，
       时长与心情值由 Thought_FxCloseMood 现算。

       ── XML 里这两项是占位 ──
       baseMoodEffect 与 durationDays 在代码里被覆写（Thought_FxCloseMood），
       因为它们的真实值取决于层数，以及玩家在模组设置里的缩放倍率。
       这里填的是"单层、倍率 1.0"的基准值，便于阅读理解。
       ⚠️ 改这里的数值不会生效 —— 要调去 FxMoodSystem.TierMood。

       ── 文案约束（重要）──
       这些描述会被单独喂给 LLM 对话模组，所以每条都必须【自带完整语境】：
       点明是外汇交易、点明方向、点明量级，然后才是画面感。
       缺了事件本身，LLM 会把"有人在打听沙发"理解成殖民者想买家具。
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- ───────────── 巨亏 ≤ -10000 · 单层 -15 · 一天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxLossHuge</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇巨亏</label>
        <description>外汇亏损过万。账房核对了三遍，数字很有耐心，一直没变。</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
      <li>
        <label>外汇巨亏</label>
        <description>又亏掉一万多。有人提议把交易终端拆了改造成花盆，没人笑。</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
      <li>
        <label>外汇巨亏</label>
        <description>交易账户上又是一个过万的窟窿。今晚集体早睡，灯灭得比平时早两个钟头。</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 大亏 -9999 ~ -5000 · 单层 -10 · 0.85 天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxLossBig</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇大亏</label>
        <description>外汇上亏掉了几千近万。这笔钱本来够全殖民地吃一百顿简单食物。</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>外汇大亏</label>
        <description>交易上又亏掉一个近万的数目。有人去问杂货商能不能赊账，杂货商把目光移开了。</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>外汇大亏</label>
        <description>这轮交易亏损接近一万。会上没人提这件事，散会时椅子响得特别整齐。</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 中亏 -4999 ~ -1000 · 单层 -7 · 0.65 天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxLossMedium</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇中亏</label>
        <description>外汇亏了几千。屏幕上的数字没怎么动，食堂的菜先素了。</description>
        <baseMoodEffect>-7</baseMoodEffect>
      </li>
      <li>
        <label>外汇中亏</label>
        <description>外汇上再添一千多的亏损。没人再往交易终端那边看。</description>
        <baseMoodEffect>-7</baseMoodEffect>
      </li>
      <li>
        <label>外汇中亏</label>
        <description>又一个几千的窟窿。账本现在归我管，谁都别问。</description>
        <baseMoodEffect>-7</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 小亏 -999 ~ -1 · 单层 -5 · 0.5 天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxLossSmall</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇小亏</label>
        <description>外汇上亏了一笔小钱。就当交学费。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>外汇小亏</label>
        <description>外汇上又多了一笔小亏损。学费交得有点勤。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>外汇小亏</label>
        <description>连着几笔小亏损下来，这学费够读一整个专业了。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 小赚 1 ~ 999 · 单层 +3 · 0.5 天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxGainSmall</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇小赚</label>
        <description>外汇上赚了一笔小的。今晚给每人加一勺蜂蜜。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>外汇小赚</label>
        <description>交易又小赚了一笔。账户鼓了一点，就一点。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>外汇小赚</label>
        <description>外汇上连着几笔盈利，都是小数目。先高兴着，别太得意。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 中赚 1000 ~ 4999 · 单层 +5 · 0.65 天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxGainMedium</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇中赚</label>
        <description>外汇赚了几千。够修一堵墙，顺带买点草药。</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
      <li>
        <label>外汇中赚</label>
        <description>交易上再进账一千多，这笔钱是干活挣来的。</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
      <li>
        <label>外汇中赚</label>
        <description>外汇上又一个几千的盈利。有人在打听沙发多少钱一张。</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 大赚 5000 ~ 9999 · 单层 +8 · 0.85 天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxGainBig</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇大赚</label>
        <description>外汇大赚，进账数千近万。这个季度能过得体面点了。</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
      <li>
        <label>外汇大赚</label>
        <description>交易上又赚了数千。有人提议给交易终端镀金，项目暂缓，但他很高兴。</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
      <li>
        <label>外汇大赚</label>
        <description>这笔交易盈利数千。交易员换上了一把带软垫的正经椅子。</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 巨赚 ≥ 10000 · 单层 +12 · 一天 ───────────── -->
  <ThoughtDef>
    <defName>RimForex_FxGainHuge</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇巨赚</label>
        <description>外汇上赚了整整一万。账房数它的时候手指在抖。</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
      <li>
        <label>外汇巨赚</label>
        <description>交易上又进账一万多。有人提议扩建银库，不然放不下。</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
      <li>
        <label>外汇巨赚</label>
        <description>外汇上再赚一万。现在发愁的是怎么花掉，这比亏钱好办。</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 爆仓 · 单层 -20 · 一天 ─────────────
       独立触发：不强平不记，强平时只记这一档（不再额外记一次普通亏损档）。 -->
  <ThoughtDef>
    <defName>RimForex_FxMarginCall</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇爆仓</label>
        <description>保证金爆了，一声不响就没了。</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
      <li>
        <label>外汇爆仓</label>
        <description>又一次爆仓，保证金全部清零。交易终端回到了出厂的样子，我们的白银没有。</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
      <li>
        <label>外汇爆仓</label>
        <description>再一次爆仓。终端前面那把椅子现在是空的，大家绕开它走。</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ───────────── 穿仓 · 单层 -28 · 一天 · 【不叠加，只有 1 个 stage】─────────────
       独立触发：强平时余额被推成负数（亏光保证金之外还倒欠平台钱）才记这一档。
       它比爆仓更重，所以心情更狠（-28 对 -20）。

       ⚠️ 这里【故意只有一个 stage】。叠加上限是 1（见 MaxStackFor），
       worker 只会传 ActiveAtStage(0)，多写的 stage 永远不可能显示 ——
       曾经写过三条递进文案，那是自相矛盾的死内容，已删。
       其他档位不叠加到 3 层是因为它们上限是 3，不是笔误。 -->
  <ThoughtDef>
    <defName>RimForex_FxBlowUp</defName>
    <workerClass>RimForex.ThoughtWorker_FxCloseMood</workerClass>
    <thoughtClass>RimForex.Thought_FxCloseMood</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>外汇穿仓</label>
        <description>穿仓了：外汇保证金亏光，账户余额被推成负数。现在我们倒欠交易平台一笔钱。</description>
        <baseMoodEffect>-28</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
